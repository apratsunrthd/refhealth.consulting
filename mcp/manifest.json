{
  "manifest_version": "0.3",
  "name": "refhealth-feed-triage",
  "display_name": "Healthcare Feed Triage",
  "version": "0.1.1",
  "description": "Inspect a healthcare event feed for timing and data quality issues inside Claude Desktop.",
  "author": { "name": "ref(health) Consulting", "url": "https://github.com/apratsunrthd" },
  "repository": { "type": "git", "url": "https://github.com/apratsunrthd/refhealth-feed-triage.git" },
  "license": "MIT",
  "privacy_policies": ["https://refhealth.consulting/feed-triage-privacy.html"],
  "homepage": "https://refhealth.consulting/feed-triage.html",
  "documentation": "https://refhealth.consulting/feed-triage.html",
  "support": "https://github.com/apratsunrthd/refhealth-feed-triage/issues",
  "server": {
    "type": "node",
    "entry_point": "server.mjs",
    "mcp_config": { "command": "node", "args": ["${__dirname}/server.mjs"] }
  },
  "tools": [{ "name": "inspect_healthcare_feed", "description": "Inspect a local CSV event feed or FHIR Bundle for timing and data quality issues." }],
  "compatibility": { "runtimes": { "node": ">=20.0.0" }, "platforms": ["darwin", "win32", "linux"] }
}
